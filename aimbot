-- --- LÓGICA VISUAL DE MARCAÇÃO ---
local function AplicarDestaque(personagem)
	if not personagem:FindFirstChild("MarcacaoInimigo") then
		local highlight = Instance.new("Highlight")
		highlight.Name = "MarcacaoInimigo"
		highlight.FillColor = CorMarcacao
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.5
		highlight.Adornee = personagem
		highlight.Parent = personagem
	end
end

local function RemoverDestaque(personagem)
	if personagem then
		local highlight = personagem:FindFirstChild("MarcacaoInimigo")
		if highlight then 
			highlight:Destroy() 
		end
	end
end

local function LimparTodosOsDestaques()
	for _, p in pairs(Players:GetPlayers()) do
		if p.Character then 
			RemoverDestaque(p.Character) 
		end
	end
end

-- --- LÓGICA ALTERNAR ESTADO (ON / OFF) ---
local function AlternarEstado()
	Ativado = not Ativado
	
	if Ativado then
		ToggleButton.Text = "STATUS: ATIVADO"
		ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		FOVCircle.Visible = true
	else
		ToggleButton.Text = "STATUS: DESATIVADO"
		ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
		FOVCircle.Visible = false
		LimparTodosOsDestaques()
	end
end

-- --- LÓGICA DE SELEÇÃO E CONTROLE DE FORÇA ---
local function ProcessarJogadoresEMira()
	local melhorAlvo = nil
	local menorDistancia = RaioFOV
	local posicaoMouse = UserInputService:GetMouseLocation()

	-- Mede o quanto você mexeu o mouse manualmente neste frame
	local movimentoMouse = UserInputService:GetMouseDelta()
	local forcaDaMao = movimentoMouse.Magnitude

	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local head = p.Character:FindFirstChild("Head")
			local humanoid = p.Character:FindFirstChild("Humanoid")
			
			if head and humanoid and humanoid.Health > 0 then
				local posTela, naTela = Camera:WorldToViewportPoint(head.Position)
				
				if naTela then
					local distancia = (Vector2.new(posTela.X, posTela.Y) - posicaoMouse).Magnitude
					if distancia < menorDistancia then
						menorDistancia = distancia
						melhorAlvo = head
					end
				end
				
				AplicarDestaque(p.Character)
			else
				RemoverDestaque(p.Character)
			end
		end
	end
	
	-- Se o aimbot estiver ligado e houver um alvo...
	if Ativado and melhorAlvo then
		-- DETECÇÃO DE FORÇA CONTRÁRIA: Se você mexer o mouse rápido o suficiente, ele solta
		if forcaDaMao > ForcaParaDesgrudar then
			melhorAlvo = nil -- Cancela a mira para este frame
		else
			local novaRotacao = CFrame.lookAt(Camera.CFrame.Position, melhorAlvo.Position)
			Camera.CFrame = Camera.CFrame:Lerp(novaRotacao, Suavidade)
		end
	end
end

-- --- LOOP QUADRO A QUADRO ---
local function ExecutarCiclo()
	local posicaoMouse = UserInputService:GetMouseLocation()
	FOVCircle.Position = UDim2.fromOffset(posicaoMouse.X, posicaoMouse.Y)
	
	ProcessarJogadoresEMira()
end

-- --- ATIVAÇÃO POR CLIQUE OU POR TECLADO ---
ToggleButton.MouseButton1Click:Connect(function()
	AlternarEstado()
end)

UserInputService.InputBegan:Connect(function(input, processado)
	if processado then 
		return 
	end 
	
	if input.KeyCode == Enum.KeyCode.LeftAlt then
		AlternarEstado()
	end
end)

-- Inicia o loop principal
ConexaoRender = RunService.RenderStepped:Connect(ExecutarCiclo)
