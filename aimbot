-- --- LÓGICA DE GERENCIAMENTO VISUAL ---

-- Função para aplicar a marcação vermelha
local function AplicarDestaque(personagem)
	if not personagem:FindFirstChild("MarcacaoInimigo") then
		local highlight = Instance.new("Highlight")
		highlight.Name = "MarcacaoInimigo"
		highlight.FillColor = CorMarcacao
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.5
		highlight.Adornee = personagem
		highlight.Parent = personagem
	end
end

-- Função para remover a marcação vermelha
local function RemoverDestaque(personagem)
	if personagem then
		local highlight = personagem:FindFirstChild("MarcacaoInimigo")
		if highlight then
			highlight:Destroy()
		end
	end
end

-- Limpa os efeitos visuais de todos os jogadores ativos
local function LimparTodosOsDestaques()
	for _, p in pairs(Players:GetPlayers()) do
		if p.Character then
			RemoverDestaque(p.Character)
		end
	end
end

-- --- LÓGICA DE SELEÇÃO E MIRA ---

-- Função para encontrar o personagem mais próximo do centro da tela
local function ObterAlvoMaisProximo()
	local melhorAlvo = nil
	local menorDistancia = RaioFOV
	local centroTela = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local head = p.Character:FindFirstChild("Head")
			local humanoid = p.Character:FindFirstChild("Humanoid")
			
			if head and humanoid and humanoid.Health > 0 then
				local posTela, naTela = Camera:WorldToViewportPoint(head.Position)
				
				if naTela then
					local distancia = (Vector2.new(posTela.X, posTela.Y) - centroTela).Magnitude
					if distancia < menorDistancia then
						menorDistancia = distancia
						melhorAlvo = head
					end
				end
				
				-- Mantém o personagem destacado enquanto o sistema procura alvos
				AplicarDestaque(p.Character)
			end
		end
	end
	return melhorAlvo
end

-- Função executada a cada quadro (Frame) para atualizar a câmera
local function ExecutarFocoMira()
	local alvo = ObterAlvoMaisProximo()
	if alvo then
		-- Calcula a rotação necessária para olhar para a cabeça do alvo
		local novaRotacao = CFrame.lookAt(Camera.CFrame.Position, alvo.Position)
		-- Suaviza a transição usando Lerp
		Camera.CFrame = Camera.CFrame:Lerp(novaRotacao, Suavidade)
	end
end

-- --- INTERAÇÃO DO BOTÃO ---

ToggleButton.MouseButton1Click:Connect(function()
	Ativado = not Ativado
	
	if Ativado then
		ToggleButton.Text = "STATUS: ATIVADO"
		ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Fundo Vermelho
		
		-- Inicia o monitoramento de quadros
		ConexaoRender = RunService.RenderStepped:Connect(ExecutarFocoMira)
	else
		ToggleButton.Text = "STATUS: DESATIVADO"
		ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)   -- Fundo Padrão
		
		-- Desconecta o monitoramento para liberar processamento
		if ConexaoRender then
			ConexaoRender:Disconnect()
			ConexaoRender = nil
		end
		
		LimparTodosOsDestaques()
	end
end)
