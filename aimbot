-- Vanguard Tactical System (Aimbot + Team Check + Highlight)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Button = script.Parent -- O botão onde este script está dentro

-- CONFIGURAÇÕES
local Ativado = false
local RaioFOV = 250 -- Tamanho do círculo de detecção
local Suavidade = 0.12 -- Quanto menor, mais rápido ele puxa a mira
local CorInimigo = Color3.fromRGB(255, 0, 0) -- Vermelho

local AlvoAtual = nil

-- FUNÇÃO PARA MUDAR O ESTADO DO BOTÃO
local function AtualizarInterface()
	if Ativado then
		Button.Text = "AIMBOT: ATIVADO"
		Button.BackgroundColor3 = Color3.fromRGB(255, 60, 60) -- Vermelho brilhante
	else
		Button.Text = "AIMBOT: DESATIVADO"
		Button.BackgroundColor3 = Color3.fromRGB(40, 40, 45) -- Cinza escuro
	end
end

-- CLIQUE DO BOTÃO
Button.MouseButton1Click:Connect(function()
	Ativado = not Ativado
	AtualizarInterface()
end)

-- FUNÇÃO PARA MARCAR INIMIGO (HIGHLIGHT)
local function AplicarHighlight(personagem)
	if not personagem:FindFirstChild("VanguardHighlight") then
		local h = Instance.new("Highlight")
		h.Name = "VanguardHighlight"
		h.FillColor = CorInimigo
		h.OutlineColor = Color3.fromRGB(255, 255, 255)
		h.FillTransparency = 0.4
		h.Parent = personagem
	end
end

local function RemoverHighlight(personagem)
	local h = personagem:FindFirstChild("VanguardHighlight")
	if h then h:Destroy() end
end

-- ENCONTRAR INIMIGO MAIS PRÓXIMO DO CENTRO (CHECK DE TIME)
local function ObterMelhorAlvo()
	local melhorAlvo = nil
	local menorDistancia = RaioFOV
	local centroTela = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

	for _, p in pairs(Players:GetPlayers()) do
		-- Verifica se NÃO é do mesmo time e se o personagem existe
		if p ~= LocalPlayer and p.Team ~= LocalPlayer.Team and p.Character then
			local head = p.Character:FindFirstChild("Head")
			local hum = p.Character:FindFirstChild("Humanoid")
			
			if head and hum and hum.Health > 0 then
				local posTela, visivel = Camera:WorldToViewportPoint(head.Position)
				
				if visivel then
					local dist = (Vector2.new(posTela.X, posTela.Y) - centroTela).Magnitude
					if dist < menorDistancia then
						menorDistancia = dist
						melhorAlvo = p.Character
					end
				end
				
				-- Aplica o efeito vermelho visual
				AplicarHighlight(p.Character)
			end
		elseif p.Character and p.Team == LocalPlayer.Team then
			-- Se for do mesmo time, garante que não tem highlight
			RemoverHighlight(p.Character)
		end
	end
	return melhorAlvo
end

-- LOOP DE MIRA
RunService.RenderStepped:Connect(function()
	if Ativado then
		AlvoAtual = ObterMelhorAlvo()
		
		if AlvoAtual and AlvoAtual:FindFirstChild("Head") then
			-- Puxa a câmera suavemente para a cabeça (Head)
			local headPos = AlvoAtual.Head.Position
			local camCFrame = CFrame.new(Camera.CFrame.Position, headPos)
			
			Camera.CFrame = Camera.CFrame:Lerp(camCFrame, Suavidade)
		end
	else
		-- Se desligar, limpa os highlights de todo mundo
		for _, p in pairs(Players:GetPlayers()) do
			if p.Character then RemoverHighlight(p.Character) end
		end
	end
end)

AtualizarInterface() -- Inicializa a GUI
