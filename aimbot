-- --- 3. LÓGICA VISUAL DE MARCAÇÃO ---
local function AplicarDestaque(personagem)
	if MarcacaoAtivada then
		if not personagem:FindFirstChild("MarcacaoInimigo") then
			local highlight = Instance.new("Highlight")
			highlight.Name = "MarcacaoInimigo"
			highlight.FillColor = CorMarcacao
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.5
			highlight.Parent = personagem
		end
	else
		local highlight = personagem:FindFirstChild("MarcacaoInimigo")
		if highlight then 
			highlight:Destroy() 
		end
	end
end

local function RemoverDestaque(personagem)
	if personagem then
		local highlight = personagem:FindFirstChild("MarcacaoInimigo")
		if highlight then 
			highlight:Destroy() 
		end
	end
end

local function LimparTodosOsDestaques()
	for _, p in pairs(Players:GetPlayers()) do
		if p.Character then 
			RemoverDestaque(p.Character) 
		end
	end
end

-- --- 4. ALTERNAR FUNÇÕES (ON / OFF) ---
local function AlternarAimbot()
	AimbotAtivado = not AimbotAtivado
	
	if AimbotAtivado then
		ToggleAimbotButton.Text = "AIMBOT: ATIVADO"
		ToggleAimbotButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		FOVCircle.Visible = true
	else
		ToggleAimbotButton.Text = "AIMBOT: DESATIVADO"
		ToggleAimbotButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
		FOVCircle.Visible = false
	end
end

local function AlternarMarcacao()
	MarcacaoAtivada = not MarcacaoAtivada
	
	if MarcacaoAtivada then
		ToggleEspButton.Text = "MARCAÇÃO: ATIVADA"
		ToggleEspButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	else
		ToggleEspButton.Text = "MARCAÇÃO: DESATIVADA"
		ToggleEspButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
		LimparTodosOsDestaques()
	end
end

-- --- 5. LÓGICA DE SELEÇÃO E CONTROLE DE SUAVIDADE/FORÇA ---
local function ProcessarMecanicas()
	local melhorAlvo = nil
	local menorDistancia = RaioFOV
	local posicaoMouse = UserInputService:GetMouseLocation()

	-- Mede o movimento físico da sua mão
	local movimentoMouse = UserInputService:GetMouseDelta()
	local forcaDaMao = movimentoMouse.Magnitude

	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local head = p.Character:FindFirstChild("Head")
			local humanoid = p.Character:FindFirstChild("Humanoid")
			
			if head and humanoid and humanoid.Health > 0 then
				local posTela, naTela = Camera:WorldToViewportPoint(head.Position)
				
				if naTela then
					local distancia = (Vector2.new(posTela.X, posTela.Y) - posicaoMouse).Magnitude
					if distancia < menorDistancia then
						menorDistancia = distancia
						melhorAlvo = head
					end
				end
				
				-- Atualiza os bonecos vermelhos se a opção estiver ligada
				AplicarDestaque(p.Character)
			else
				RemoverDestaque(p.Character)
			end
		end
	end
	
	-- Se o aimbot estiver ligado e achar alguém no círculo
	if AimbotAtivado and melhorAlvo then
		-- DESGRUDAR: Se você empurrar o mouse com uma forcinha pro lado, ele limpa a mira
		if forcaDaMao > ForcaParaDesgrudar then
			melhorAlvo = nil 
		else
			-- Puxada de mira super suave baseada na variável Suavidade
			local novaRotacao = CFrame.lookAt(Camera.CFrame.Position, melhorAlvo.Position)
			Camera.CFrame = Camera.CFrame:Lerp(novaRotacao, Suavidade)
		end
	end
end

-- --- 6. EVENTOS E ENTRADAS ---

-- Loop Principal (Frame por frame)
ConexaoRender = RunService.RenderStepped:Connect(function()
	local posicaoMouse = UserInputService:GetMouseLocation()
	FOVCircle.Position = UDim2.fromOffset(posicaoMouse.X, posicaoMouse.Y)
	
	ProcessarMecanicas()
end)

-- Botão de abrir/fechar o quadradinho
